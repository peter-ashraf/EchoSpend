{
  "expo": {
    "name": "EchoSpend",
    "slug": "echospend-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.peter.echospend",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "EchoSpend needs microphone access to record and parse your voice expenses offline."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.peter.echospend",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "EchoSpend needs microphone access to record and parse your voice expenses offline."
        }
      ]
    ]
  }
}
